<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KatalogProduktow4L.Mobile.DetailsPage"
             Title="DetailsPage">
    <VerticalStackLayout>
        <Button Text="Usuń" Clicked="UsunButtonClicked"  
                WidthRequest="100" HeightRequest="48"
                BackgroundColor="Red" HorizontalOptions="End"/>
        <Label Text="Nazwa:" />
        <Entry x:Name="NazwaEntry" />
        <Label Text="Cena:" />
        <Entry x:Name="CenaEntry" />
        <Label Text="Ilość:" />
        <Entry x:Name="IloscEntry" />
        <!--
        <Label Text="Kategoria:" />
        <Picker x:Name="KategoriaPicker">
            <Picker.Items>
                <x:String>Elektronika</x:String>
                <x:String>Odzież</x:String>
                <x:String>Jedzenie</x:String>
            </Picker.Items>
        </Picker>
        -->
        <Button Text="Zapisz" Clicked="ZapiszButtonClicked" />
        <Button Text="Powrót" Clicked="PowrotButtonClicked" />
    </VerticalStackLayout>
</ContentPage>