<Window x:Class="KatalogProduktow4L.Desktop.DockPanelDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogProduktow4L.Desktop"
        mc:Ignorable="d"
        Title="DockPanelDemo" Height="450" Width="800">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Katalog produktów"
                   FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
            <Button Content="Dodaj produkt" Margin="10" />
            <Button Content="Usuń produkt" Margin="10" />
        </StackPanel>
        <ListBox x:Name="ListaProduktow" />
    </DockPanel>
</Window>
