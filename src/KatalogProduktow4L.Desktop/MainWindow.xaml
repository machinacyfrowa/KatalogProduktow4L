
    <Window x:Class="KatalogProduktow4L.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KatalogProduktow4L.Desktop"
        mc:Ignorable="d"
        Title="KatalogProduktow4L.Desktop" Height="600" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- mały wiersz, reszta okna, mały wiersz-->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- reszta okna, 300px -->
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                    Text="Katalog produktów" HorizontalAlignment="Center" 
                   FontSize="24" Margin="0,0,0,20"/>
        <ListBox Grid.Row="1" Grid.Column="0"
            x:Name="ProduktyListBox">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- szablon jednego wiersza listy -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Nazwa}" Width="220" FontWeight="Bold" />
                        <TextBlock Text="{Binding Kategoria}" Width="120" />
                        <TextBlock Text="{Binding Cena, StringFormat={}{0:F2}zł}" Width="100" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <!-- panel szczegółów po prawej stronie okna -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="20,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <GroupBox Grid.Row="0" Header="Szczegóły produktu" 
                      DataContext="{Binding SelectedItem, ElementName=ProduktyListBox}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Nazwa:"/>
                    <TextBox x:Name="NazwaTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding Nazwa}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cena:"  Margin="0,5,0,0"/>
                    <TextBox x:Name="CenaTextBox" Grid.Row="1" Grid.Column="1" Text="{Binding Cena, StringFormat={}{0:F2}zł}" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ilość:"  Margin="0,5,0,0"/>
                    <TextBox x:Name="IloscTextBox" Grid.Row="2" Grid.Column="1" Text="{Binding Ilosc}" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Kategoria:"  Margin="0,5,0,0"/>
                    <!-- to jeszcze nie działa prawidłowo -->
                    <ComboBox x:Name="KategoriaComboBox" Grid.Row="3" Grid.Column="1" Margin="0,5,0,0">
                        <ComboBoxItem Content="Elektronika" />
                        <ComboBoxItem Content="Odzież" />
                        <ComboBoxItem Content="Jedzenie" />
                    </ComboBox>
                    <!-- inne przydatne kontrolki -->
                    <!-- tylko zeby pokazać - nie ląduja w finalnym projekcie
                    <CheckBox x:Name="PromocjaCheckBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="Promocja" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Data dostawy:" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                    <DatePicker x:Name="DataDostawyDatePicker" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Sposób dostawy:" FontSize="18" FontWeight="Bold" Margin="0,5,0,0"/>
                    <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,5,0,0">
                        <RadioButton x:Name="DostawaKurierRadioButton" Content="Kurier" GroupName="SposobDostawy"/>
                        <RadioButton x:Name="DostawaPocztaRadioButton" Content="Poczta" GroupName="SposobDostawy"/>
                   
                    </StackPanel> -->
                    <!-- w zależności od typu produktu -->
                    <!-- collapsed nie będzie widoczny dopóki nie włączycie go z kodu -->
                    <StackPanel x:Name="KolorStackPanel" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="Collapsed" Margin="0,5,0,0">
                        <TextBlock Text="Kolor:" FontSize="18" FontWeight="Bold"/>
                        <TextBox x:Name="KolorTextBox" Margin="5,0,0,0" />
                    </StackPanel>
                    <!-- te wartości są tylko do odczytu -->
                    <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding WartoscMagazynu, StringFormat=Wartość magazynu: {0:F2}zł}" 
                               FontSize="14" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding OpisProduktu}" Margin="0,5,0,0"/>
                </Grid>
            </GroupBox>
            <GroupBox Grid.Row="1" Header="Nowy produkt:">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Rodzaj:"/>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <RadioButton x:Name="NowyRodzajRadioButtonProdukt" Content="Produkt" GroupName="NowyRodzaj"/>
                        <RadioButton x:Name="NowyRodzajRadioButtonPodzespol" Content="Podzespół" GroupName="NowyRodzaj"/>
                        <RadioButton x:Name="NowyRodzajRadioButtonAkcesorium" Content="Akcesorium" GroupName="NowyRodzaj"/>
                        <RadioButton x:Name="NowyRodzajRadioButtonUsluga" Content="Usługa" GroupName="NowyRodzaj"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nazwa:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NowyNazwaTextBox" Grid.Row="1" Grid.Column="1"
                             Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cena:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NowyCenaTextBox" Grid.Row="2" Grid.Column="1" Margin="0,5,0,0" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Ilość:" Margin="0,5,0,0"/>
                    <TextBox x:Name="NowyIloscTextBox" Grid.Row="3" Grid.Column="1" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Kategoria:" Margin="0,5,0,0"/>
                    <ComboBox x:Name="NowyKategoriaComboBox" Grid.Row="4" Grid.Column="1" Margin="0,5,0,0   ">
                        <ComboBoxItem Content="Elektronika" />
                        <ComboBoxItem Content="Odzież" />
                        <ComboBoxItem Content="Jedzenie" />
                    </ComboBox>
                    <Button x:Name="NowyProduktButton" 
                            Content="Dodaj Produkt"  Margin="0,5,0,0"
                            Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" />
                </Grid>
            </GroupBox>
        </Grid>
       
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="20,0,0,0">
            <TextBlock Text="Produktów: "/>
            <TextBlock x:Name="LiczbaProduktowTextBlock" FontWeight="Bold"/>
            <TextBlock Text=" | Wartość magazynu: "/>
            <TextBlock x:Name="WartoscProduktowTextBlock" FontWeight="Bold"/>
            <!--<Button Content="Drugie okno" Margin="10" Click="Button_Click" />-->
        </StackPanel>
    </Grid>
</Window>
